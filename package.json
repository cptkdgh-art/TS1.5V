{
  "name": "jinpok-ts-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "codemap": "node scripts/build-source-map.mjs",
    "codemap:check": "node scripts/build-source-map.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:review": "vitest run --config tests/review/vitest.config.ts",
    "smoke": "playwright test",
    "verify": "npm run codemap:check && npm run lint && npm run test:run && npm run test:review && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@google/genai": "^1.45.0",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.4.32",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "$sharp"
    }
  }
}
